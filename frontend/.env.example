# Frontend (Expo) env: copy to frontend/.env.
# Every value here is bundled into the PUBLIC app, so only EXPO_PUBLIC_* settings
# belong here. Server secrets go in backend/.env.

# Backend URL: http://localhost:8787 for web/simulator, http://<LAN-IP>:8787 for a device
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase project URL and anon / publishable key (never the service-role key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional
# "Contact Atelier" address in the store app (contact buttons hidden when unset)
EXPO_PUBLIC_SUPPORT_EMAIL=
# Mirrors the backend DEBUG_TRYON: skips the credit gate and shows a DEBUG label
EXPO_PUBLIC_DEBUG_TRYON=false
# Show "Sign in with Apple"
EXPO_PUBLIC_APPLE_SIGNIN=false
