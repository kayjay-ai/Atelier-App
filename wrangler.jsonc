// Cloudflare Worker that serves the web build of the app (frontend/dist) as
// static files. No server code: Cloudflare builds the site from the repo root
// (npm ci && npm run build:web) and uploads frontend/dist.
// 404.html and the _redirects rules for dynamic routes are generated by
// frontend/scripts/web-postbuild.mjs as part of build:web.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./frontend/dist",
    // Expo exports one .html file per route; serve /store/plan from store/plan.html.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get the app's not-found page (copied to 404.html by build:web).
    "not_found_handling": "404-page"
  }
}
