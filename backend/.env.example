# Atelier API — server-only environment. Copy to backend/.env (gitignored).
# Every value here is a SERVER secret or setting; never copy these into the app's
# frontend/.env (anything EXPO_PUBLIC_* is bundled into the app).

# --- Gemini FREE key (Style, Size & Color Assistants — text + vision) ---
# No billing needed. Get a free key at https://aistudio.google.com
# If left blank, all three assistants degrade to warm, on-brand canned responses.
# Swap TEXT_MODEL=gemini-2.5-flash-lite for higher free-tier rate limits.
GEMINI_TEXT_API_KEY=
TEXT_MODEL=gemini-2.5-flash

# --- Google Gemini image models (Virtual Try-On) ---
# Get a key at https://aistudio.google.com — billing MUST be enabled on the
# Google Cloud project for image-generation models to work.
# If left blank, live try-on falls back to the demo images in backend/data/tryon.
GEMINI_API_KEY=
IMAGE_MODEL=gemini-3-pro-image-preview
# economy | standard — which image model try-on uses
IMAGE_QUALITY=economy
IMAGE_MODEL_ECONOMY=gemini-3.1-flash-lite-image
# Fallback if primary image model returns no image (optional)
IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image
# Try-on quality check: a cheap text-model call reviews each result and retries once on a bad one (false = off)
TRYON_VERIFY=true

# --- Demo / debug ---
# true: Virtual Try-On instantly serves pre-generated images from backend/data/tryon
#   (created by `npm run seed:tryon`) — never fails, safe for live pitches.
# false: calls Gemini's image model live (15-30s) for a real composited try-on.
DEMO_MODE=true
# true: return a stub try-on image (no Gemini call, no credit spent)
# DEBUG_TRYON=false

# --- Supabase (server-side) ---
# If left blank, the API runs without a database and credit gating is disabled.
# (The older name VITE_SUPABASE_URL is still accepted. See lib/db.mjs.)
SUPABASE_URL=
# Service role key — SERVER-ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cashfree Payments ---
# SERVER-ONLY secrets. Prices/credits live in lib/pricing.mjs (single source of truth).
# Get sandbox credentials at https://merchant.cashfree.com → Developers → API Keys
# (toggle the dashboard to "Test/Sandbox" mode first). Switch CASHFREE_ENV to
# `production` (and swap in live keys) only after sandbox testing passes.
# Production also needs: the web app and API domains whitelisted in Cashfree
# (Developers > Whitelisting), the webhook <API_PUBLIC_URL>/api/payments/webhook
# registered (Developers > Webhooks), and a real 10-digit customer phone on
# every order (the app asks shoppers; stores use b2b_companies.primary_contact).
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# PG webhooks are signed with the API secret key by default; set this only if you
# configured a distinct webhook secret in the Cashfree dashboard.
CASHFREE_WEBHOOK_SECRET=
# Public HTTPS bases used to build the checkout return URL and the webhook notify
# URL. Leave blank in local dev (the status endpoint verifies instead; Cashfree
# cannot reach localhost). In production set both, e.g. https://app.example.com
# and https://api.example.com, and register <API_PUBLIC_URL>/api/payments/webhook
# in the Cashfree dashboard.
APP_PUBLIC_URL=
API_PUBLIC_URL=
# B2B in-app payments: the store must accept these Terms before paying.
# Optional: blank uses the built-in Terms page (legal/b2b-terms.html at /legal/b2b-terms).
# Set both to use your own page; bump the version when it changes.
B2B_TERMS_URL=
B2B_TERMS_VERSION=

# --- Embed SSO (white-label iframe) — SERVER-ONLY secrets ---
# Secret Atelier uses to sign its own short-lived embed SESSION tokens.
ATELIER_EMBED_SECRET=
# Built-in "demo" client (local testing): its shared signing secret, its
# server-to-server partner API key, and the origins allowed to frame Atelier.
EMBED_DEMO_SECRET=
EMBED_DEMO_API_KEY=
EMBED_DEMO_ORIGINS=http://localhost:5199,http://localhost:5173
# Production clients as a JSON array, e.g.:
# EMBED_CLIENTS_JSON=[{"client_id":"acme","secret":"...","api_key":"...","allowed_origins":["https://shop.acme.com"],"name":"Acme"}]
EMBED_CLIENTS_JSON=
# Atelier embed session lifetime (seconds); refreshable. Default 3600.
EMBED_SESSION_TTL_SEC=3600

# --- API server ---
PORT=8787
# Comma-separated frontend origins allowed to call this API via CORS in production,
# e.g. https://app.example.com . Localhost (incl. Expo web :8081) is always allowed.
CORS_ALLOWED_ORIGINS=

# --- B2B operations: notifications + daily job ---
# Transactional email (Resend). Unset → notifications are recorded as 'skipped'.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
NOTIFY_REPLY_TO=
# Links inside credit emails.
B2B_UPGRADE_URL=
B2C_UPGRADE_URL=
# Shared secrets for the server-to-server endpoints (unset = endpoint disabled).
JOBS_SECRET=
ADMIN_API_SECRET=
