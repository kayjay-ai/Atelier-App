{
  "name": "atelier",
  "private": true,
  "description": "Atelier: Expo app (frontend/) + Express API (backend/) + Supabase SQL (supabase/)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,app -c blue,magenta \"npm:dev:api\" \"npm:dev:app\"",
    "dev:app": "npm run start -w frontend",
    "dev:api": "npm run dev:watch -w backend",
    "build:web": "npm run build:web -w frontend",
    "start": "npm start -w backend",
    "typecheck": "npm run typecheck -w frontend",
    "job:daily": "npm run job:daily -w backend"
  },
  "devDependencies": {
    "concurrently": "9.1.2"
  }
}
